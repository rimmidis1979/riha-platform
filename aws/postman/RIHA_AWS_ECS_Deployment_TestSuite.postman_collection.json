      "name": "01 - Stock AI Executive Command & Market Ingestor",
      "item": [
        {
          "name": "1.1 Executive Portfolio & Account Summary (Zero-Mock Verification)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var data = pm.response.json();",
                  "pm.test(\"Response schema matches executive summary contract\", function () {",
                  "    pm.expect(data).to.have.property(\"netAccountEquityUsd\");",
                  "    pm.expect(data).to.have.property(\"availableBuyingPowerUsd\");",
                  "    pm.expect(data).to.have.property(\"unrealizedPnlUsd\");",
                  "    pm.expect(data).to.have.property(\"monitoredTickers\");",
                  "});",
                  "pm.test(\"ZERO MOCK POLICY: Balances are strictly $0.00 until Robinhood MCP connected\", function () {",
                  "    pm.expect(data.netAccountEquityUsd).to.be.oneOf([0, 0.0, 0.00]);",
                  "    pm.expect(data.availableBuyingPowerUsd).to.be.oneOf([0, 0.0, 0.00]);",
                  "    pm.expect(data.unrealizedPnlUsd).to.be.oneOf([0, 0.0, 0.00]);",
                  "    pm.expect(data.realizedTodayPnlUsd).to.be.oneOf([0, 0.0, 0.00]);",
                  "});",
                  "pm.test(\"Equity sparkline does not contain fake upward curve\", function () {",
                  "    if (data.portfolioEquitySparkline && data.portfolioEquitySparkline.length > 0) {",
                  "        var allZeros = data.portfolioEquitySparkline.every(function(val) { return val === 0; });",
                  "        pm.expect(allZeros).to.be.true;",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{alb_base_url}}/api/v1/stock-ai/summary/executive",
              "host": ["{{alb_base_url}}"],
              "path": ["api", "v1", "stock-ai", "summary", "executive"]
            },
            "description": "Verifies that the executive portfolio summary strictly enforces the Zero Mock Data Policy ($0.00 balance until live broker connected)."
          }
        },
