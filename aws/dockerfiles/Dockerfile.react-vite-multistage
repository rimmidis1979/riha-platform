# ==============================================================================
# RIHA ENTERPRISE PLATFORM - PRODUCTION MULTI-STAGE DOCKERFILE (REACT VITE)
# Target Architecture: AWS ECS Fargate
# Node Version: Node.js 22 Alpine -> Nginx Stable Alpine
# ==============================================================================

# STAGE 1: Node.js Build Stage
FROM node:22-alpine AS builder

WORKDIR /app

# Cache package manifests
COPY package*.json ./
RUN npm ci

# Copy application source & bundle production static assets
COPY . .
RUN npm run build

# STAGE 2: Hardened Nginx Runtime Stage
FROM nginx:stable-alpine AS runtime

LABEL maintainer="RIHA Software Solutions <dev@rihasoftwaresolutions.com>"
LABEL organization="RIHA Software Solutions"

# Remove default nginx welcome page
RUN rm -rf /usr/share/nginx/html/*

# Copy built distribution artifacts
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy optimized ECS Service Connect reverse-proxy Nginx configuration
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

HEALTHCHECK --interval=15s --timeout=5s --retries=3 --start-period=5s \
  CMD wget -q -O /dev/null http://127.0.0.1/ || exit 1

ENTRYPOINT ["nginx", "-g", "daemon off;"]

